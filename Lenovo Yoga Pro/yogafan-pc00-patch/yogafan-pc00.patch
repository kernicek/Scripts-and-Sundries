+/*
+ * Yoga Pro 9 14IRP8 (83BU) and other newer Intel platforms use the PC00/LPCB
+ * ACPI naming instead of the PCI0/LPC0 the stock configs assume. The FANS
+ * object itself is present and identical; only the path differs. Extra
+ * candidates are harmless: acpi_get_handle simply fails and the path is skipped.
+ */
+static const struct yogafan_config yoga_pc00_cfg = {
+	.multiplier = 100,
+	.fan_count = 4,
+	.paths = { "\\_SB.PC00.LPCB.EC0.FANS",
+		   "\\_SB.PC00.LPCB.EC0.FA2S",
+		   "\\_SB.PC00.LPCB.H_EC.FANS",
+		   "\\_SB.PC00.LPCB.H_EC.FA2S" }
+};
+
 static void apply_rllag_filter(struct yoga_fan_data *data, int idx, long raw_rpm)
 {
 	ktime_t now = ktime_get_boottime();
@@ -171,6 +186,14 @@

 static const struct dmi_system_id yogafan_quirks[] = {
 	{
