+		.matches = {
+			DMI_MATCH(DMI_SYS_VENDOR, "LENOVO"),
+			DMI_MATCH(DMI_PRODUCT_NAME, "83BU"),
+		},
+		.driver_data = (void *)&yoga_pc00_cfg,
+	},
+	{
 		.ident = "Lenovo Yoga",
 		.matches = {
 			DMI_MATCH(DMI_SYS_VENDOR, "LENOVO"),
@@ -222,6 +245,8 @@

 		status = acpi_get_handle(NULL, (char *)cfg->paths[i],
 					 &data->active_handles[data->fan_count]);
+		pr_info("yogafan: path %s -> %s\n", cfg->paths[i],
+			ACPI_SUCCESS(status) ? "FOUND" : "absent");
 		if (ACPI_SUCCESS(status))
 			data->fan_count++;
 	}
